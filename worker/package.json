{
  "name": "herbert-leaderboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env= --persist-to .wrangler/state",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "check": "prettier --check . && tsc --noEmit",
    "test": "node --test scripts/check-*.mjs && vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local --env= --persist-to .wrangler/state",
    "migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "format": "prettier --write ."
  },
  "dependencies": {
    "jose": "6.2.12",
    "obscenity": "0.4.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
