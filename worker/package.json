{
  "name": "herbert-leaderboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "prettier --check . && tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "format": "prettier --write ."
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
